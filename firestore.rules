rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', 'cliente');
    }

    function isStaff() {
      return signedIn() && myRole() in ['admin', 'it'];
    }

    // fecha 'YYYY-MM-DD' con al menos ~3 dias de anticipacion.
    // ponytail: aproximado a 72h UTC (la zona America/Caracas se valida exacta en cliente)
    function conAnticipacion(fecha) {
      return timestamp.date(
        int(fecha.split('-')[0]),
        int(fecha.split('-')[1]),
        int(fecha.split('-')[2])
      ) >= request.time + duration.value(72, 'h');
    }

    match /plans/{planId} {
      // Home muestra planes sin sesion
      allow read: if true;
      allow write: if isStaff();
    }

    match /profiles/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      // El propio usuario crea su perfil siempre como cliente; staff crea cualquiera
      allow create: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.get('role', 'cliente') == 'cliente');
      // El propio usuario no puede tocar role, plan ni stamps
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.get('role', 'cliente') == resource.data.get('role', 'cliente')
            && request.resource.data.get('plan', null) == resource.data.get('plan', null)
            && request.resource.data.get('stamps', 0) == resource.data.get('stamps', 0));
      allow delete: if isStaff();
    }

    match /reservas/{reservaId} {
      allow read: if isStaff() || (signedIn() && resource.data.usuario_id == request.auth.uid);
      // Cliente solo crea reservas propias, siempre por aprobar
      allow create: if isStaff()
        || (signedIn()
            && request.resource.data.usuario_id == request.auth.uid
            && request.resource.data.estado_reserva == 'por_aprobar'
            && request.resource.data.fecha is string
            && request.resource.data.hora_inicio is string);
      // Cliente solo puede cancelar (unico campo tocable), con anticipacion y sobre reservas vivas
      allow update: if isStaff()
        || (signedIn()
            && resource.data.usuario_id == request.auth.uid
            && resource.data.estado_reserva in ['por_aprobar', 'aprobada']
            && request.resource.data.estado_reserva == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado_reserva'])
            && conAnticipacion(resource.data.fecha));
      allow delete: if isStaff();
    }
  }
}
